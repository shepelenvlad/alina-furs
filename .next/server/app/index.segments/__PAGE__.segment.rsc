1:[["children",{"s":"__PAGE__","h":128,"d":{"r":["$","$2","c",{"children":[["$","main",null,{"className":"main","children":[["$","$L5","0",{"block":{"type":"hero","anchor":"hero","slides":[{"title":"Выбирай себя","text":"Ну что драгоценная…\n\nЯ верю: один новый выбор может запустить очень красивые трансформации в жизни.\n\nИ я с тобой, чтобы помочь тебе этот выбор сделать.","buttonLabel":"Интро видео","buttonLink":"https://youtu.be/pP3oU5mEc1A?si=gibryI4gkyQDhcE2","isVideo":true},{"title":"Сборник и Закрытое сообщество","text":"Сборник 18 практик для глубокой работы с самооценкой, эмоциями и отношениями\n\n🪄Письменные упражнения, телесные упражнения и медитации","buttonLabel":"Узнать больше","buttonLink":"#features","isVideo":false},{"title":"Личные консультации","text":"Личные консультации: 50 минут глубокой внутренней работы над состоянием и мышлением для разрешения запроса","buttonLabel":"Узнать больше","buttonLink":"#cons","isVideo":false}]}}],["$","section","1",{"id":"about","className":"about section","children":[["$","div",null,{"className":"container section-title","data-aos":"fade-up","children":[["$","h2",null,{"children":"Сборник практик"}],["$","p",null,{"children":"Один новый выбор - красивые трансформации в жизни"}]]}],["$","div",null,{"className":"container","children":["$","div",null,{"className":"row gy-4","children":[["$","div",null,{"className":"col-lg-6","data-aos":"fade-up","data-aos-delay":"200","children":[[["$","p","p-0",{"children":"Ну что драгоценная, пришло время выбирать себя, сделав красивый вклад в свое состояние"}],"\n",["$","p","p-1",{"children":["$","em","em-0",{"children":["$","strong","strong-0",{"children":"🪄 Выделяй от 10-30 минут в день и наслаждайся, как меняется твоя самооценка, состояние и отношения с мужчинами."}]}]}],"\n",["$","p","p-2",{"children":"Наполнение как 3 больших курса, за которые ты могла бы заплатить в 20 раз дороже."}],"\n",["$","p","p-3",{"children":["$","em","em-0",{"children":["$","strong","strong-0",{"children":"🪄 3 блока: Эмоции, отношения, самооценка (возможность приобрести 1,2 или все 3) Материал будет на Яндекс и Гугл диске в виде документов, аудио и видео файлов"}]}]}]],["$","a",null,{"href":"#","className":"read-more","children":[["$","span",null,{"children":"Получить доступ"}],["$","i",null,{"className":"bi bi-arrow-right"}]]}]]}],["$","div",null,{"className":"col-lg-6 content","data-aos":"fade-up","data-aos-delay":"100","children":[[["$","p","p-0",{"children":["$","em","em-0",{"children":["$","strong","strong-0",{"children":"🪄 После приобретения любого из блоков ты попадаешь в закрытый чат-сообщество со мной и девушками, кто также приобрел сборник."}]}]}],"\n",["$","p","p-1",{"children":"Что будет в сообществе:"}]],["$","ul",null,{"children":[["$","li","0",{"children":[["$","i",null,{"className":"bi bi-check2"}]," ",["$","span",null,{"children":"Возможность обратной связи от меня по заданиям"}]]}],["$","li","1",{"children":[["$","i",null,{"className":"bi bi-check2"}]," ",["$","span",null,{"children":"Возможность задать мне вопрос и получить глубокий, развернутый ответ"}]]}],["$","li","2",{"children":[["$","i",null,{"className":"bi bi-check2"}]," ",["$","span",null,{"children":"Эксклюзивные подкасты и посты от меня, которые нет в соц.сетях. На темы: самооценки и любви к себе, состояния, отношений и духовности. Чтобы услышать такую глубину нужно созреть и если ты в сообществе, ты готова!"}]]}],["$","li","3",{"children":[["$","i",null,{"className":"bi bi-check2"}]," ",["$","span",null,{"children":"Теплое, душевное общение с единомышленницами"}]]}]]}]]}]]}]}]]}],["$","$L6","2",{"block":{"type":"tabs","anchor":"features","title":"Сборник практик","subtitle":"А ЧТО В САМИХ СБОРНИКАХ?🪄","tabs":[{"heading":"БЛОК «ОТНОШЕНИЯ»\n6 практик, которые помогают:","listTitle":"Какие проблемы помогут решить практики:","list1":["Полюбить свою женскую свободу и кайфовать от жизни даже если нет отношений","Начать привлекать и тянуться к достойным, надежным мужчинам","Жить из состояния: «я ценная женщина, достойная любви»","Быть самодостаточной женщиной, для которой мужчина — не весь мир, а лишь его красивая часть"],"list2":["Страх остаться одной и не встретить своего человека","Зависимость от человека, «залипание»","Встречаются холодные, недоступные, отвергающие мужчины, с кем не будет счастья и здоровых отношений","Чувство отвержения, покинутости, «меня не ценят» в сфере отношений"],"buttonLabel":"Узнать цену за блок","buttonLink":"#pricing","image":"/uploads/working-1.jpg","label":"БЛОК «ОТНОШЕНИЯ»"},{"heading":"БЛОК «САМООЦЕНКА»\n6 практик, которые помогают:","listTitle":"Какие проблемы помогут решить практики:","list1":["Увидеть, признать и прочувствовать свою ценность, уникальность и силу","Сблизиться с дорогими людьми, потому что разрешаешь себе быть собой рядом с ними, быть уязвимой","Наслаждаться жизнью, потому что ты разрешаешь себе просто быть, а не бежать 24/7 за «лучшей версией себя»","Обрести веру в себя, которая основана не просто на «поднятой мотивации», но и на понимании своей силы","Из состояния веры в себя и ощущения своей силы ты начинаешь делать выборы, на которые раньше не решалась: например, поступить на учебу, переехать, найти работу уровнем выше или начать свой проект, выйти из нездоровых отношений, пойти на сложный разговор…"],"list2":["Недовольство собой, чувство недостаточности","Чрезмерное стремление быть самой лучшей, умной, красивой, сильной, успешной. Страх быть неидеальной, слабой или уязвимой","Отсутствие веры в себя, состояние «я не могу»"],"buttonLabel":"Узнать цену за блок","buttonLink":"#pricing","image":"/uploads/working-2.jpg","label":"БЛОК «САМООЦЕНКА»"},{"heading":"БЛОК «ЭМОЦИИ, СОСТОЯНИЕ»\n6 практик, которые помогают:","listTitle":"Какие проблемы помогут решить практики:","list1":["Научиться управлять своими эмоциями","Возвращаться в ясный ум и принимать решения осознанно","Минимизировать конфликты, ведь вы перестаете говорить с людьми на эмоциях обиды, гнева","Снизить уровень стресса (высокий уровень стресса не только влияет на радость жизни, но и снижает качество сна, иммунитет и уровень энергии)","Перевести фокус с негатива на позитив: меньше негативных переживаний = больше энергии на реализацию своих мечт и целей, выстраивание красивых отношений"],"list2":["Сильные эмоции в моменте, которые захватывают","Принятие решений или ссоры на эмоциях","Ощущение «испорченного дня», потому что ты долго была в тревоге, гневе, обиде…"],"buttonLabel":"Узнать цену за блок","buttonLink":"#pricing","image":"/uploads/working-3.jpg","label":"БЛОК «ЭМОЦИИ, СОСТОЯНИЕ»"}]}}],"$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12"]}],["$L13"],"$L14"]}],"p":"$@15","v":null,"s":"$16"}}]]
